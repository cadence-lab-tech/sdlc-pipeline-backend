{
  "name": "codex",
  "kit": {
    "manifest": ".agents/clab-kit.json",
    "skills_dir": ".agents/skills",
    "agents_dir": ".codex/agents"
  },
  "mcp": {
    "method": "codex-config-toml",
    "table": "mcp_servers",
    "bearer_token_env_var": "SDLC_TOKEN",
    "scopes": ["user", "project"]
  },
  "run": [
    "codex", "exec", "--json", "--sandbox", "workspace-write",
    "--skip-git-repo-check", "--ignore-user-config",
    "--add-dir", "{run_dir}",
    "-c", "sandbox_workspace_write.network_access=true",
    "-c", "shell_environment_policy.exclude=[\"SDLC_TOKEN\"]",
    "-c", "hooks.PreToolUse=[{matcher=\"Bash\",hooks=[{type=\"command\",command={hook_script}}]}]",
    "--dangerously-bypass-hook-trust",
    "-m", "{model}",
    "-c", "model_reasoning_effort=\"{effort}\"",
    "-c", "mcp_servers.sdlc.url=\"{mcp_url}\"",
    "-c", "mcp_servers.sdlc.bearer_token_env_var=\"SDLC_TOKEN\"",
    "{prompt}"
  ],
  "prompt": "text",
  "executor": "process",
  "hook": {
    "placement": "launch",
    "agent": "clab-stage",
    "event": "PreToolUse",
    "matcher": "Bash"
  },
  "output": "codex-jsonl",
  "detect": [
    {"env": "CODEX_THREAD_ID", "non_empty": true}
  ],
  "levels": null,
  "tool_policy": null,
  "env": ["OPENAI_*", "CODEX_*"]
}
