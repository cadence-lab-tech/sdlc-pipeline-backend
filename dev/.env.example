# Скопировать в dev/.env и поправить при конфликте портов.
# Файл не обязателен: без него берутся значения по умолчанию из compose.

# POSTGRES_USER=sdlc
# POSTGRES_PASSWORD=sdlc
# POSTGRES_DB=sdlc
POSTGRES_PORT=55432

API_PORT=8088
ADMINER_PORT=8089

SDLC_LOG_LEVEL=info
SDLC_DEFAULT_ACTOR=local-dev

# Сиды применяются только на пустой базе. Через запятую, порядок важен:
# drift_demo опирается на данные default_workflow.
SDLC_SEED=default_workflow

# true — гейт нереализованного типа валит переход (значение для продакшена).
SDLC_STRICT_GATES=false
