# Скопировать в dev/.env и поправить при конфликте портов.
# Файл не обязателен: без него берутся значения по умолчанию из compose.

# POSTGRES_USER=sdlc
# POSTGRES_PASSWORD=sdlc
# POSTGRES_DB=sdlc
POSTGRES_PORT=55432

API_PORT=8088
ADMINER_PORT=8089

SDLC_LOG_LEVEL=info
SDLC_DEFAULT_ACTOR=local-dev

# Сиды применяются только на пустой базе. Через запятую, порядок важен:
# drift_demo опирается на данные default_workflow.
SDLC_SEED=default_workflow

# true — гейт нереализованного типа валит переход (значение для продакшена).
SDLC_STRICT_GATES=false

# MCP-сервер для локальных агентов: /mcp/projects/{PROJECT}.
SDLC_MCP_ENABLED=true

# Аренда задачи агентом. Интервал продления обязан быть меньше срока жизни,
# иначе сервис не стартует. Значения задаются и приложению, и воркеру.
SDLC_LEASE_TTL=30m
SDLC_HEARTBEAT_INTERVAL=5m
SDLC_LEASE_SWEEP_INTERVAL=1m

# Кто заводит проекты: open — любой вошедший (создатель становится
# администратором проекта), teams — администратор системы и лиды команд.
SDLC_PROJECT_CREATION=open

# Вход через GitHub: Client ID и Client secret того же GitHub App (раздел
# «OAuth» в настройках приложения, callback — https://<ui>/login/github).
# SDLC_GITHUB_APP_CLIENT_ID=Iv1.0123456789abcdef
# SDLC_GITHUB_APP_CLIENT_SECRET=…
# Для GitHub Enterprise адрес сайта отличается от адреса API.
# SDLC_GITHUB_URL=https://github.com

# Объектное хранилище вместо тома blobs: нужно, когда реплик api несколько.
# Локально поднимается профилем s3 (docker compose --profile s3 up -d minio
# minio-init), ключи ниже заодно заводят пользователя MinIO.
# SDLC_BLOB_S3_BUCKET=sdlc-blobs
# SDLC_BLOB_S3_ENDPOINT=http://minio:9000
# SDLC_BLOB_S3_REGION=us-east-1
# SDLC_BLOB_S3_ACCESS_KEY_ID=sdlc
# SDLC_BLOB_S3_SECRET_ACCESS_KEY=sdlcsdlc
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
