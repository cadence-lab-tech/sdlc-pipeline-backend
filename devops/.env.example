# Настройки для скриптов devops/bin и Terraform.
# Копия: cp devops/.env.example devops/.env — в git не едет.

# Токен Timeweb Cloud: https://timeweb.cloud/my/api-keys
# Им пользуются Terraform-провайдер и twc-get.sh.
# У токена должно быть ВЫКЛЮЧЕНО подтверждение удаления серверов через
# Telegram — иначе terraform destroy виснет в ожидании ручного нажатия.
TWC_TOKEN=

# --- подключение к машине ---------------------------------------------------
# IP берётся из вывода terraform: ./devops/bin/tf.sh output server_ip
SDLC_SSH_HOST=
SDLC_SSH_USER=deploy
SDLC_SSH_PORT=22
# Приватный ключ. Пусто — берётся ключ по умолчанию из ~/.ssh.
SDLC_SSH_KEY=
SDLC_REMOTE_DIR=/opt/sdlc

# --- домен ------------------------------------------------------------------
# Нужен только для внешних проверок в diagnose.sh.
SDLC_DOMAIN=
