# TLS Caddy выписывает и продлевает сам: от него нужны A-запись на этот
# сервер и доступные снаружи порты 80 и 443.
{
	email {$ACME_EMAIL}
}

# Один домен на всё. Интерфейс и API на одном origin — браузеру не нужен
# CORS, а агентам и CLI — второй адрес.
{$SDLC_DOMAIN} {
	encode zstd gzip

	# То, что обслуживает сервис. Список префиксов — это роутер httpapi:
	# /v1 — REST, /mcp и /mcp/* — агенты (/mcp без косой черты —
	# инстансовый адрес, CLAB-483: шаблон /mcp/* его не ловит), /webhooks —
	# GitHub, /healthz и /readyz — пробы, /.well-known/oauth-* — метаданные
	# сервера авторизации OAuth для удалённых MCP-клиентов (RFC 8414,
	# RFC 9728; решение 0079). Только эти два документа: остальное в
	# /.well-known — интерфейса. Всё остальное — интерфейс.
	@backend path /v1/* /mcp /mcp/* /webhooks/* /healthz /readyz /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @backend {
		# MCP отвечает потоком (SSE): буферизация ответа сломала бы его.
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# Интерфейс отдаёт свой Caddy (см. Dockerfile интерфейса) с откатом на
	# index.html: маршруты вроде /projects/SDLC/tasks/42 живут в React Router.
	# Порт 8080: образ интерфейса работает без root и слушает :8080 с
	# 1ccb530 (CLAB-236), :80 у него уходит (CLAB-248). Образ интерфейса
	# старше 1ccb530 на этом Caddyfile не отвечает (CLAB-247).
	handle {
		reverse_proxy ui:8080
	}
}
