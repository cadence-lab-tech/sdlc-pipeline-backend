# Конфигурация стека на сервере: /opt/sdlc/.env, права 600. В git не едет.
# Первый раз файл собирает devops/bin/bootstrap-env.sh: подставляет домен и
# ключи S3 из Terraform и генерирует секреты на самой машине.

# --- домен ----------------------------------------------------------------
# Один адрес на интерфейс, /v1, /mcp и /webhooks. A-запись ведёт на IP машины.
SDLC_DOMAIN=sdlc.example.ru
# Сюда Let's Encrypt напишет, если продление сертификата начнёт падать.
ACME_EMAIL=admin@example.ru

# --- база -----------------------------------------------------------------
POSTGRES_USER=sdlc
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sdlc

# --- первый администратор --------------------------------------------------
# В пустой базе некому выдать первый токен, поэтому он приходит из окружения
# (решение 0021). Заводится на старте, при рестарте не дублируется.
SDLC_ADMIN_HANDLE=admin
# sdlc_$(openssl rand -hex 24)
SDLC_ADMIN_TOKEN=
# Кто заводит проекты: open — любой вошедший (решение 0030).
SDLC_PROJECT_CREATION=open
# Поставка (решение 0033): shared — общий инстанс, тариф free ограничивает
# организацию тремя участниками; single — выделенный инстанс, квот нет.
SDLC_TENANCY=shared
# Сиды — только на пустой базе. Пусто: проекты заводят сами коллеги.
# default_workflow — демонстрационный цикл, если нужен образец.
SDLC_SEED=

# --- вход через GitHub ----------------------------------------------------
# Client ID и secret того же GitHub App; callback — https://$SDLC_DOMAIN/login/github.
# Пусто — на странице входа остаётся только токен.
SDLC_GITHUB_APP_CLIENT_ID=
SDLC_GITHUB_APP_CLIENT_SECRET=

# --- доступ к репозиториям --------------------------------------------------
# GitHub App: ключ лежит в /opt/sdlc/secrets/github-app.pem (права 600),
# в контейнер каталог смонтирован как /secrets.
SDLC_GITHUB_APP_ID=
SDLC_GITHUB_APP_KEY_FILE=
# Запасной путь — общий токен на чтение.
SDLC_GITHUB_TOKEN=
# Секрет подписи вебхуков: тот же вписывается в настройки приложения на
# GitHub, адрес — https://$SDLC_DOMAIN/webhooks/github.
# openssl rand -hex 24
SDLC_GITHUB_WEBHOOK_SECRET=

# --- содержимое артефактов: S3 Timeweb ------------------------------------
# Из выводов Terraform: s3_bucket, s3_endpoint, s3_region, s3_access_key,
# s3_secret_key. Пустой бакет — содержимое ложится на том blobs.
SDLC_BLOB_S3_BUCKET=
SDLC_BLOB_S3_ENDPOINT=
SDLC_BLOB_S3_REGION=
SDLC_BLOB_S3_PREFIX=
SDLC_BLOB_S3_ACCESS_KEY_ID=
SDLC_BLOB_S3_SECRET_ACCESS_KEY=

# --- эмбеддинги -------------------------------------------------------------
# Без ключа поиск полнотекстовый. С ключом воркер векторизует код и артефакты.
SDLC_VOYAGE_API_KEY=

# --- необязательное ---------------------------------------------------------
# SDLC_OIDC_ISSUER=
# SDLC_OIDC_CLIENT_ID=
# SDLC_BOOTSTRAP_TEAM=
# SDLC_LOG_LEVEL=info
# SDLC_INDEX_INTERVAL=5m

# --- образы -----------------------------------------------------------------
# Эти строки переписывает deploy.sh, подставляя короткий SHA коммита.
# Тег `:latest` в реестр не пушится намеренно: по .env всегда видно, какой
# именно коммит крутится. До первой выкладки значения нерабочие — так и надо.
IMAGE_BACKEND=ghcr.io/cadence-lab-tech/sdlc-pipeline-backend:none
IMAGE_FRONTEND=ghcr.io/cadence-lab-tech/sdlc-pipeline-frontend:none
